# ==================================================
# Server Configuration
# ==================================================
PORT=5000
NODE_ENV=development
API_VERSION=v1.0.0
CORS_ORIGINS=http://localhost:3000
LIVE_FRONTEND_URL=http://localhost:3000

# ==================================================
# Google OAuth (same client ID as dashboard — for ID token verification)
# ==================================================
GOOGLE_CLIENT_ID=your_google_client_id

# ==================================================
RESEND_API_KEY=your_super_secret_resend_api_key_change_this
EMAIL_FROM=your_super_secret_email_from_change_this

# ==================================================
# JWT Configuration
# ==================================================
NEXTAUTH_SECRET=your_super_secret_nextauth_secret_change_this
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_VALIDITY=24h

# ==================================================
# Database Configuration
# ==================================================
MONGODB_URI=mongodb://localhost:27017/kavach

# ==================================================
# Logging Configuration
# ==================================================
LOG_LEVEL=info

# ==================================================
# Encryption Configuration
# ==================================================
AES_SECRET=your_super_secret_aes_key_change_this
INVITE_SECRET=your_super_secret_invite_secret_change_this

# ==================================================
# Cloudflare R2 Configuration
# ==================================================
R2_ENDPOINT=your_super_secret_r2_endpoint_change_this
R2_ACCESS_KEY_ID=your_super_secret_r2_access_key_id_change_this
R2_SECRET_ACCESS_KEY=your_super_secret_r2_secret_access_key_change_this
R2_BUCKET_NAME=your_super_secret_r2_bucket_name_change_this
R2_PUBLIC_URL=your_super_secret_r2_public_url_change_this
