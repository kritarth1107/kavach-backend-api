# ==================================================
# Server Configuration
# ==================================================
PORT=5000
NODE_ENV=development
API_VERSION=v1.0.0
CORS_ORIGINS=http://localhost:3000
LIVE_FRONTEND_URL=http://localhost:3000

# ==================================================
# Google OAuth (same client ID as dashboard — for ID token verification)
# ==================================================
GOOGLE_CLIENT_ID=your_google_client_id

# ==================================================
# Kawach AI Engine (Saheli / RAG)
# ==================================================
AI_ENGINE_URL=http://localhost:8000
KAWACH_API_SECRET=dev-secret

# ==================================================
# WhatsApp (mock | meta)
# ==================================================
WHATSAPP_PROVIDER=meta
KAVACH_WHATSAPP_NUMBER=+91XXXXXXXXXX
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_WABA_ID=
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_META_GRAPH_VERSION=v21.0

# ==================================================
RESEND_API_KEY=your_super_secret_resend_api_key_change_this
EMAIL_FROM=your_super_secret_email_from_change_this

# ==================================================
# JWT Configuration
# ==================================================
NEXTAUTH_SECRET=your_super_secret_nextauth_secret_change_this
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_VALIDITY=24h

# ==================================================
# Health (protected detailed endpoint)
# ==================================================
HEALTH_SECRET=change_me_for_local_dev

# ==================================================
MONGODB_URI=mongodb://localhost:27017/kavach

# ==================================================
# Logging Configuration
# ==================================================
LOG_LEVEL=info

# ==================================================
# Encryption Configuration
# ==================================================
AES_SECRET=your_super_secret_aes_key_change_this
INVITE_SECRET=your_super_secret_invite_secret_change_this

# ==================================================
# Cloudflare R2 Configuration
# ==================================================
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kavach
R2_PUBLIC_URL=https://cdn.kavach.care

# ==================================================
# Voice (STT Chirp3 / Gemini fallback + ElevenLabs TTS)
# ==================================================
# GCP_PROJECT_ID=kavach-care
# SPEECH_LOCATION=us
# VERTEX_LOCATION=global
# VERTEX_STT_MODEL=gemini-3.5-flash
# ELEVENLABS_API_KEY=
# ELEVEN_LABS_API_KEY=
# ELEVENLABS_VOICE_ID=A5W9pR9OjIbu80J0WuDW  # Anika – Natural Conversations (default)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2


# ==================================================
# Saheli private browser (Gemini multimodal + Playwright)
# ==================================================
# auto | playwright | dry_run — Cloud Run image installs Chromium; prod sets auto
BROWSER_WORKER_MODE=auto
# Grocery/food primary path: private browser for Swiggy/Zomato/Blinkit/Zepto/Instamart (default ON).
# Set COMMERCE_BROWSER_FIRST=0 to restore MCP as primary (adapters/OAuth kept either way).
COMMERCE_BROWSER_FIRST=1
# COMMERCE_BROWSER_FIRST_PARTNERS=swiggy,zomato,blinkit,zepto,instamart
# Pharmacy Continue/Send-OTP — default off (SMS spam kill). Set on to re-enable.
BROWSER_PHARMACY_LOGIN=off
# Pharmacy login needs more headroom than rides (cold Chromium + Login + OTP UI).
# BROWSER_TASK_DEADLINE_MS=75000
# BROWSER_SCREENSHOT_DIR=/tmp/saheli-browser-fail
# BROWSER_PROFILE_DIR=/var/data/saheli-browser-profiles
# COMMERCE_SESSION_ENCRYPTION_KEY=  # 64-hex or any string (sha256) for AES-GCM profiles
# VERTEX_BROWSER_MODEL=gemini-3.5-flash
